				>
			</File>
		</Filter>
		<Filter
			Name="SDK"
			Filter="h;hpp;hxx;hm;inl;inc;lib"
			UniqueIdentifier="{6C3F1A2B-8D4E-4C1A-9E5F-1A2B3C4D5E6F}"
			>
			<File
